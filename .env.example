DATABASE_URL=postgres://remedio:remedio@localhost:5432/remedio
# Set to "false" to disable live lookups against the openFDA drug label API
OPENFDA_ENABLED=true

# Interaction extraction (npm run extract). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional overrides
# REMEDIO_EXTRACT_MODEL=claude-opus-5-5
# REMEDIO_EXTRACT_EFFORT=medium
